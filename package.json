{
  "name": "agrologio",
  "productName": "Αγρολόγιο",
  "version": "0.3.1",
  "description": "Κόστος και έσοδα αγροτικών εργασιών ανά αγροτεμάχιο",
  "author": "Nick",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-app": "node build-app.js",
    "dist": "node build-app.js && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "gr.agrologio.app",
    "productName": "Agrologio",
    "artifactName": "Agrologio-Setup-${version}.exe",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "afterPack": "./after-pack.js",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Αγρολόγιο",
      "uninstallDisplayName": "Αγρολόγιο",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1032"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nikos-1",
        "repo": "agrologio",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@fontsource/commissioner": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "resedit": "3.1.0",
    "xlsx": "0.18.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikos-1/agrologio.git"
  }
}
